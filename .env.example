# DevPilot AI configuration.
# Copy to .env and fill in values. Nothing here is read yet; these are the
# settings planned for upcoming milestones.

# Amazon Bedrock (LLM planner)
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=

# Investigation budgets
DEVPILOT_MAX_STEPS=25
DEVPILOT_MAX_DURATION_MS=300000

# Directory for temporary git worktrees used to apply and verify fixes
DEVPILOT_WORKSPACE_DIR=.devpilot

# HTTP API
DEVPILOT_API_PORT=8787
