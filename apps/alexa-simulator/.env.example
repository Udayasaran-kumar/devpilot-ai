# Server-side only. None of these reach the browser.

# The DevPilot MCP server endpoint (loopback http, or https).
DEVPILOT_MCP_URL=http://127.0.0.1:8788/mcp
# The MCP server's bearer token. Required; at least 16 characters.
DEVPILOT_MCP_TOKEN=
# Port for the simulator page and its /api/dialog endpoint, on 127.0.0.1.
DEVPILOT_SIMULATOR_PORT=8790
# Optional: repository to investigate when the user does not name one.
DEVPILOT_DEMO_REPOSITORY_ID=
